# Copier vers .env pour docker compose (ne pas committer .env)

# PostgreSQL
POSTGRES_PASSWORD=fretcorridor123

# MinIO
MINIO_ROOT_USER=fretcorridor
MINIO_ROOT_PASSWORD=fretcorridor123

# Backend — JWT (générer une clé forte en production, min. 32 caractères)
JWT_SECRET=change-me-in-production-use-long-random-string

# Backend — datasource (optionnel, valeurs par défaut dans compose)
SPRING_DATASOURCE_PASSWORD=fretcorridor123
MINIO_ACCESS_KEY=fretcorridor
MINIO_SECRET_KEY=fretcorridor123
